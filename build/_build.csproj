<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Frameworks" />
    <PackageReference Include="Fallout.Common"/>
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="coveralls.net" Version="[4.0.1]" />
    <PackageDownload Include="dotnet-coverage" Version="[18.10.0]" />
    <PackageDownload Include="GitVersion.Tool" Version="[6.8.2]"/>
    <PackageDownload Include="ReportGenerator" Version="[5.5.11]"/>
  </ItemGroup>

</Project>
